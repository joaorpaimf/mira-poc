  {
   "id": "e2t",
   "type": "text",
   "x": 1165,
   "y": 342,
   "width": 448.8,
   "height": 280.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
